# Copy this file to .env.local and fill in the values from your EXISTING
# Doctor Supabase project (Project Settings > API).
#
# Only the public URL and the anon / publishable key go here.
# NEVER put a service_role or secret key in this file: every VITE_* value is
# bundled into the public JavaScript that browsers download.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
